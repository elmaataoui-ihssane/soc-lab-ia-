# ============================================
# SOC Lab - Configuration d'Environnement
# ============================================
# Copier en .env et remplir vos valeurs

# --- Wazuh Indexer (OpenSearch) ---
INDEXER_HOST=https://192.168.10.135:9200
INDEXER_USER=admin
INDEXER_PASSWORD=your_indexer_password

# --- Wazuh API Management ---
WAZUH_API_HOST=https://192.168.10.135:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=your_api_password

# --- Ollama (Local LLM) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Vector Database (Chroma) ---
CHROMA_PATH=./chroma_mitre
CHROMA_SPACE=cosine  # euclidienne ou cosine

# --- LangGraph Orchestration ---
MAX_RETRIES=2

# --- Streamlit ---
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/soc_lab.log

# --- Mode Développement ---
DEBUG=false
VERBOSE=false
